{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.internal/schemas/roundtrip-workout-fixture.json",
  "title": "Round-trip workout fixture",
  "description": "A real workout exported from the Workout Library (Export -> Test fixture .json), dropped into workouts/tests/fixtures/roundtrip/. workouts.test_roundtrip synthesizes plausible activity laps from this tree and feeds them through infer_workout(), checking the heuristic reconstructs the original structure. Same {name, sport, steps} shape as WorkoutStep/WorkoutCreate in openapi.yaml.",
  "type": "object",
  "required": ["name", "sport", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "sport": { "type": "string", "enum": ["bike", "run"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["warmup", "block", "rec", "cool", "repeat"] },
        "end_type": { "type": ["string", "null"], "enum": ["time", "distance", "manual", null] },
        "duration": { "type": ["integer", "null"], "description": "Seconds; required when end_type is time." },
        "distance": { "type": ["integer", "null"], "description": "Metres; required when end_type is distance." },
        "target_type": { "type": ["string", "null"], "enum": ["power", "hr", "pace", "cadence", "open", null] },
        "target_low": { "type": ["number", "null"] },
        "target_high": { "type": ["number", "null"] },
        "target2_type": { "type": ["string", "null"], "enum": ["cadence", "none", null] },
        "target2_low": { "type": ["number", "null"] },
        "target2_high": { "type": ["number", "null"] },
        "repeat": { "type": ["integer", "null"], "minimum": 1, "description": "Only meaningful when kind=repeat." },
        "note": { "type": ["string", "null"] },
        "children": {
          "type": ["array", "null"],
          "description": "Present only when kind=repeat.",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    }
  }
}
