VITE_API_BASE_URL=http://localhost:8080

# Only needed when building against a backend whose OAUTH_FIRST_PARTY_CLIENT_SECRET has been
# changed from its dev-only default (i.e. staging/production) - see infra/RUNBOOK.md §7. Left
# unset, api/auth.ts falls back to the same "dev-only-secret-change-me" default the local Java
# backend uses, which is correct for local dev but WRONG for any deploy: login still works (it
# doesn't need the client secret), but every silent token refresh fails with invalid_client,
# forcing users back to the login screen on any full page load.
# VITE_OAUTH_CLIENT_SECRET=
